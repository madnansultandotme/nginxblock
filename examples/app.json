{
    "domain": "app.example.com",
    "https": true,
    "certificate": "/etc/letsencrypt/live/app.example.com/fullchain.pem",
    "certificateKey": "/etc/letsencrypt/live/app.example.com/privkey.pem",
    "redirectHttp": true,
    "hideVersion": true,
    "gzip": true,
    "clientMaxBodySizeMb": 20,
    "upstreams": [
        {
            "name": "api",
            "strategy": "least_conn",
            "servers": [
                {
                    "address": "10.0.0.10:5000"
                },
                {
                    "address": "10.0.0.11:5000"
                }
            ]
        }
    ],
    "routes": [
        {
            "path": "/api/",
            "type": "proxy",
            "target": "api",
            "rateLimit": {
                "rate": 10,
                "burst": 20
            },
            "websocket": true
        },
        {
            "path": "/",
            "type": "static",
            "root": "/srv/app",
            "spa": true
        }
    ]
}